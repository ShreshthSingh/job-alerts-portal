# Copy this to .streamlit/secrets.toml for local runs (gitignored), or paste
# the same keys/values into the Streamlit Community Cloud app's Secrets panel
# when deployed. Never commit the real secrets.toml.

GITHUB_CLIENT_ID = "your-oauth-app-client-id"
GITHUB_CLIENT_SECRET = "your-oauth-app-client-secret"

# Must exactly match the OAuth App's "Authorization callback URL".
# Local testing: "http://localhost:8501"
# Deployed: your Streamlit Community Cloud app URL, e.g. "https://your-app.streamlit.app"
REDIRECT_URI = "http://localhost:8501"

# The repo that gets forked into each visitor's GitHub account. This must
# match your actual `git remote -v` - it's private, so only GitHub accounts
# you've added as collaborators (Settings -> Collaborators) can fork it.
TEMPLATE_REPO_OWNER = "ShreshthSingh"
TEMPLATE_REPO_NAME = "job-scraper"
